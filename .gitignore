# Live deal data (contains real client data — excluded from repo)
deals_data.json
deals_data.backup-*.json

# monday app credentials hand-off file (imported by `npm run install:all`, then deleted)
monday-app.json

# Client logos fetched from Wikidata / client websites (cache next to deals_data.json)
/client_logos/

# Real iSBD reference deck (client deal text + slide renders) — local only;
# clones fall back to frontend/src/features/isbd/isbdReference.sample.json
frontend/src/features/isbd/isbdReference.json
frontend/public/isbd-bg/ref_slide*.png

# Outlook calendar cache written by core/shared/outlook_calendar.ps1 (personal calendar data)
outlook_calendar_cache.json

# Scratch / test output files
_cal_test.txt
_cal_test2.txt
_calout.txt
_proc.txt
_sta_test.txt
_sta2.txt

# Optional local analysis scratch
*.tmp

# GSSM server artifacts
gssm-server/engine-imports/
gssm-server/.gssm/

# Packaged builds (npm run package): staging folder, download cache, zips
release/
*.sqlite
*.sqlite-wal
*.sqlite-shm
