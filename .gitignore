# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Node
node_modules/
npm-debug.log*

# Frontend dev artifacts
frontend/node_modules/.vite-temp/

# Local generated document renders and uploaded working documents
documents/*_slides/
documents/*.pptx
documents/*.pptx.*
documents/*.docx
documents/*.docx.*
core/documents/*_slides/
core/documents/*.pptx
core/documents/*.pptx.*
